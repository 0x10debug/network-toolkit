# Shared Docker network name (optional override, defaults to mb-proxy).
# All load balancer and backend containers join this network.
# MB_PROXY_NETWORK=mb-proxy

# ── HAProxy stats page credentials ───────────────────────────────────────────
# Used by the HAProxy stats frontend on port 9999 (127.0.0.1 only).
# Replace with secure credentials before deploying.
STATS_USER=admin
STATS_PASSWORD=changeme
