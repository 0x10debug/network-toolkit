# Primary domain — used by Caddy, ddns-go, and as the base for subdomains
PRIMARY_DOMAIN=

# Shared frp auth secret between frps (VPS) and frpc (home). Long random string.
FRP_TOKEN=

# DNS provider API token for ddns-go (e.g. Cloudflare API token)
DDNS_TOKEN=

# Shared proxy network name (optional override, defaults to mb-proxy)
# MB_PROXY_NETWORK=mb-proxy
