# ── OAuth2 Proxy ─────────────────────────────────────────────────────────────
# Primary domain — used for the redirect URL and cookie scope.
PRIMARY_DOMAIN=

# Provider: google | github | oidc
# For google/github, only CLIENT_ID + CLIENT_SECRET are needed.
# For oidc, also set OAUTH2_PROXY_OIDC_ISSUER_URL.
OAUTH2_PROXY_PROVIDER=google

# OAuth2 client credentials — register an OAuth2 app with your provider.
# Google:  https://console.cloud.google.com/apis/credentials
# GitHub:  https://github.com/settings/developers
# OIDC:    your IdP's client registration page
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Cookie secret — must be 16, 24, or 32 bytes (base64). Generate with:
#   openssl rand -base64 32 | head -c 32 && echo
OAUTH2_PROXY_COOKIE_SECRET=

# Restrict login to specific email domains (comma-separated). Leave empty to
# allow any email from the provider.
OAUTH2_PROXY_EMAIL_DOMAINS=

# OIDC only — the issuer URL of your OIDC provider (e.g. https://accounts.google.com)
OAUTH2_PROXY_OIDC_ISSUER_URL=

# Redirect URL — must match the OAuth2 app's authorized redirect URI.
# Default: https://auth.${PRIMARY_DOMAIN}/oauth2/callback
# OAUTH2_PROXY_REDIRECT_URL=https://auth.example.com/oauth2/callback

# Upstream backend that oauth2-proxy proxies after auth. For forward_auth
# usage this is rarely hit; set it to a dummy upstream or your app.
# OAUTH2_PROXY_UPSTREAMS=http://127.0.0.1:8080

# ── Authelia ─────────────────────────────────────────────────────────────────
# Storage encryption key — used to encrypt sensitive values in the DB.
# Generate with: openssl rand -hex 32
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# JWT secret — used for signing JWT tokens issued by Authelia.
# Generate with: openssl rand -hex 32
AUTHELIA_JWT_SECRET=

# Session secret — used to encrypt session data in cookies.
# Generate with: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=

# Log level: debug | info | warn | error
AUTHELIA_LOG_LEVEL=info

# MySQL backend (optional — leave commented to use SQLite)
# AUTHELIA_STORAGE_MYSQL_HOST=
# AUTHELIA_STORAGE_MYSQL_DATABASE=authelia
# AUTHELIA_STORAGE_MYSQL_USERNAME=authelia
# AUTHELIA_STORAGE_MYSQL_PASSWORD=

# ── Shared ───────────────────────────────────────────────────────────────────
# Shared Docker network name (optional override, defaults to mb-proxy).
# MB_PROXY_NETWORK=mb-proxy
