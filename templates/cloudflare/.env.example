# Cloudflare Tunnel ID (from the Cloudflare dashboard / `cloudflared tunnel create`)
TUNNEL_ID=

# Tunnel token (from the Cloudflare dashboard when running the tunnel via token)
TUNNEL_TOKEN=

# Primary domain routed through the tunnel to Caddy
PRIMARY_DOMAIN=

# Shared proxy network name (optional override, defaults to mb-proxy)
# MB_PROXY_NETWORK=mb-proxy
