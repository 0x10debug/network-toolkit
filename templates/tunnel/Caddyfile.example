# Caddyfile.example — route public domain to the frp tunnel target (Caddy v2.9)
#
# Caddy forwards traffic to localhost:TUNNEL_LOCAL_PORT, which is the port the
# frp server exposes from the home network via the tunnel.
#
# HTTP/3 (QUIC) is enabled by default in Caddy 2; the compose file maps
# UDP 443 so QUIC traffic reaches Caddy.

{$TUNNEL_DOMAIN:tunnel.example.com} {
    reverse_proxy localhost:{$TUNNEL_LOCAL_PORT:8080} {
        # Active health check (Caddy v2.9) — the tunnel target may go offline
        # when the home frp client disconnects; this detects it quickly.
        health_uri /
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
