# Public domain Caddy gets a certificate for (e.g. home.example.com)
TUNNEL_DOMAIN=

# Local port on the VPS that frps exposes from the home tunnel. Caddy forwards
# to this port. Must match the remotePort configured on the frp client.
TUNNEL_LOCAL_PORT=8080

# Shared secret between frps (VPS) and frpc (home). Use a long random string.
FRP_TOKEN=

# Shared proxy network name (optional override, defaults to mb-proxy)
# MB_PROXY_NETWORK=mb-proxy
