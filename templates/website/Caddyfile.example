# Caddyfile.example — single-site reverse proxy with security headers (Caddy v2.9)
#
# Copy to Caddyfile and let Caddy read {$PRIMARY_DOMAIN:example.com}, {$APP_HOST:app},
# {$APP_PORT:8080} from the environment (set in .env / compose).
#
# HTTP/3 (QUIC) is enabled by default in Caddy 2; the compose file maps
# UDP 443 so QUIC traffic reaches Caddy.

{$PRIMARY_DOMAIN:example.com} {
    reverse_proxy {$APP_HOST:app}:{$APP_PORT:8080} {
        # Active health check (Caddy v2.9) — marks the backend down if it
        # stops responding, so requests fail fast instead of hanging.
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
