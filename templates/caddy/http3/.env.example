# Primary domain Caddy will request a certificate for (e.g. example.com)
PRIMARY_DOMAIN=

# Backend app hostname as seen on the mb-proxy network (e.g. myapp)
APP_HOST=

# Backend app port (e.g. 8080)
APP_PORT=8080

# Shared proxy network name (optional override, defaults to mb-proxy)
# MB_PROXY_NETWORK=mb-proxy
