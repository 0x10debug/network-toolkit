# Caddyfile.example — HTTP/3 (QUIC) enabled single-site reverse proxy (Caddy v2.9)
#
# This is a focused example showing how to enable HTTP/3 with Caddy v2.9.
# HTTP/3 runs over QUIC (UDP), so the compose file must map UDP 443 in addition
# to TCP 443, and the firewall must allow inbound UDP 443.
#
# Copy to Caddyfile and let Caddy read {$PRIMARY_DOMAIN}, {$APP_HOST},
# {$APP_PORT} from the environment (set in .env / compose).

{
    # Enable HTTP/1.1, HTTP/2, and HTTP/3 (QUIC) — Caddy v2.9
    # This is the key directive for HTTP/3. Without it, Caddy still supports
    # HTTP/3 by default when UDP 443 is available, but setting it explicitly
    # makes the intent clear and lets you control which protocols are served.
    protocols h1 h2 h3
}

{$PRIMARY_DOMAIN} {
    reverse_proxy {$APP_HOST}:{$APP_PORT} {
        # Active health check (Caddy v2.9)
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
