# Caddyfile.example — HTTP/3 (QUIC) enabled single-site reverse proxy (Caddy v2.9)
#
# This is a focused example showing how to enable HTTP/3 with Caddy v2.9.
# HTTP/3 runs over QUIC (UDP), so the compose file must map UDP 443 in addition
# to TCP 443, and the firewall must allow inbound UDP 443.
#
# Copy to Caddyfile and let Caddy read {$PRIMARY_DOMAIN:example.com}, {$APP_HOST:app},
# {$APP_PORT:8080} from the environment (set in .env / compose).

# Caddy has HTTP/1.1, HTTP/2, and HTTP/3 enabled by default. To pin or
# restrict the served protocols, set them explicitly in the global servers
# block as below.

{
    servers {
        # h3 = HTTP/3 over QUIC, served on UDP 443
        protocols h1 h2 h3
    }
}

{$PRIMARY_DOMAIN:example.com} {
    reverse_proxy {$APP_HOST:app}:{$APP_PORT:8080} {
        # Active health check (Caddy v2.9)
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
