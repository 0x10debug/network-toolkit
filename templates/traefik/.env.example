# Primary domain Traefik will request certificates for (e.g. example.com).
# Wildcard SAN (*.${PRIMARY_DOMAIN}) is configured in traefik.yml.
PRIMARY_DOMAIN=

# Email address for Let's Encrypt ACME account. Use a real address — Let's
# Encrypt sends expiry warnings here. Never commit a real address to the repo.
ACME_EMAIL=

# Shared Docker network name (optional override, defaults to mb-proxy).
# Traefik discovers containers on this network only.
# MB_PROXY_NETWORK=mb-proxy
