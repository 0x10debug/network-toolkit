# Caddyfile.example — multi-site reverse proxy with security headers (Caddy v2.9)
#
# Copy to Caddyfile. Each block is one domain routed to its own backend.
# Add or remove blocks to match the number of sites you host.
#
# HTTP/3 (QUIC) is enabled by default in Caddy 2; the compose file maps
# UDP 443 so QUIC traffic reaches Caddy.

{$SITE_1_DOMAIN:site1.example.com} {
    reverse_proxy {$SITE_1_HOST:app1}:{$SITE_1_PORT:8081} {
        # Active health check (Caddy v2.9)
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}

{$SITE_2_DOMAIN:site2.example.com} {
    reverse_proxy {$SITE_2_HOST:app2}:{$SITE_2_PORT:8082} {
        # Active health check (Caddy v2.9)
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
