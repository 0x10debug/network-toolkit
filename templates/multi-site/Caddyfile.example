# Caddyfile.example — multi-site reverse proxy with security headers
#
# Copy to Caddyfile. Each block is one domain routed to its own backend.
# Add or remove blocks to match the number of sites you host.

{$SITE_1_DOMAIN} {
    reverse_proxy {$SITE_1_HOST}:{$SITE_1_PORT}

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}

{$SITE_2_DOMAIN} {
    reverse_proxy {$SITE_2_HOST}:{$SITE_2_PORT}

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /data/caddy/access.log
        format json
    }
}
