# Shared Docker network name for the socket-proxy (optional override,
# defaults to mb-socket-proxy). This MUST be an internal network so the
# proxy is never reachable from the host or the public internet:
#   docker network create --internal mb-socket-proxy
# MB_SOCKET_PROXY_NETWORK=mb-socket-proxy

# ── Endpoint allowlist ────────────────────────────────────────────────────
# Every endpoint defaults to 0 (denied). Set to 1 only the ones a consumer
# actually needs. The socket-proxy blocks anything not listed here.
#
# Read-only endpoints (GET/HEAD). CONTAINERS=1 lets a consumer list and
# inspect containers; it does NOT allow create/kill/exec unless POST=1 too.
CONTAINERS=1
EXEC=0
IMAGES=0
INFO=0
NETWORKS=0
NODES=0
PLUGINS=0
SERVICES=0
SESSION=0
SWARM=0
SYSTEM=0
TASKS=0
VOLUMES=0

# Write endpoints (POST/PUT/DELETE). Keep these 0 unless a consumer must
# mutate Docker state. POST=1 combined with CONTAINERS=1 allows container
# create/kill/restart — enable deliberately.
POST=0
BUILD=0
COMMIT=0
CONFIGS=0
DISTRIBUTION=0
EVENTS=0
SECRETS=0
